```gitignore
# Compiled/Binary files
*.class
*.o
*.obj
*.so
*.dll
*.exe

# Dependencies
libs/
lib/

# Build outputs
build/
bin/
gen/
out/

# IDE files
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo

# Logs
*.log

# Environment
.env
.env.local
*.env.*

# Coverage
coverage/
htmlcov/
*.coverage

# Gradle
.gradle/
.gradle/
!gradle/wrapper/
!gradle.properties

# Android specific
*.apk
*.aar
local.properties
captures/
.externalNativeBuild
.intermediates
.kotlin
```