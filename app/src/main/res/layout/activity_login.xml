<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lilaPastel"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Título llamativo -->
        <TextView
            android:id="@+id/tvTituloBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIENVENIDOS A\nTODOLISTAPP"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/rosaPastel"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            android:fontFamily="sans-serif-black"/>

        <!-- Panel de inicio de sesión -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INICIAR SESIÓN"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/grisTexto"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"/>

                <!-- Campo Usuario -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/rosaPastel"
                    app:hintTextColor="@color/rosaPastel">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsuarioLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Usuario"
                        android:inputType="text"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Clave -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/rosaPastel"
                    app:hintTextColor="@color/rosaPastel"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etClaveLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Clave"
                        android:inputType="textPassword"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Spinner de Roles -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar Rol"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/grisTexto"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/spinnerRol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:padding="12dp"/>

                <!-- Botón Ingresar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIngresar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INGRESAR"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingVertical="12dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/rosaPastel"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Registrar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REGISTRAR"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="12dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/mentaPastel"
            app:icon="@android:drawable/ic_menu_add"
            app:iconGravity="textStart"/>

    </LinearLayout>
</ScrollView>
